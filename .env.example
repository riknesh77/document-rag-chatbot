# Local development: copy to .env.local. On Vercel set these in Project Settings;
# never upload .env.local or use NEXT_PUBLIC_ names for credentials.

# PostgreSQL URL; replace the password locally (URL-encode special characters).
DATABASE_URL=postgresql://rag_user:CHANGE_ME@localhost:5432/document_rag?schema=public

# Used only by the optional local Docker database. Match the password in DATABASE_URL.
POSTGRES_PASSWORD=

# Local Qwen remains the development default. Set groq on Vercel.
GENERATION_PROVIDER=local
# Required only for hosted generation. Never expose this key to the browser.
GROQ_API_KEY=
# Groq model with >=32K context. Confirm availability for your account.
GENERATION_MODEL=openai/gpt-oss-20b
